// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model for NextAuth Credentials & OAuth
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for credentials auth
  role          String    @default("USER") // "USER", "admin", "super_admin"
  plan          String    @default("FREE") // "FREE", "PREMIUM", "LIFETIME"
  platform      String?   @default("Web")  // "WhatsApp", "Instagram", "Google", "Direct", "Mobile Web", "Web"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ─── Referral / Wallet ────────────────────────────────────────
  referralCode  String?   @unique         // e.g. "ABC123" — their shareable code
  referredById  String?                   // Which user referred them
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]    @relation("Referrals")
  walletBalance Int       @default(0)     // in paise (₹500 = 50000)

  events        Event[]
  payments      Payment[]
  accounts      Account[]
  sessions      Session[]
  walletTxns    WalletTransaction[]

  @@index([email])
  @@index([referralCode])
}

// Storing the created memory pages (events)
model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId     String
  theme       Theme     @relation(fields: [themeId], references: [id])
  
  customData  String?   // Store structured JSON configuration string
  
  status      String    @default("DRAFT") // "DRAFT", "PUBLISHED", "DISABLED", "EXPIRED"
  expiresAt   DateTime? 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media       Media[]
  responses   Response[]

  @@index([userId, status])
  @@index([slug])
  @@index([createdAt])
}

// Uploaded photos/audio linked to events
model Media {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  url       String
  type      String    // "IMAGE", "AUDIO", "VIDEO"
  size      Int?      
  
  createdAt DateTime  @default(now())

  @@index([eventId])
}

// Razorpay transaction records
model Payment {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  razorpayOrderId   String    @unique
  razorpayPaymentId String?   @unique
  amount            Int       
  currency          String    @default("INR")
  status            String    @default("PENDING") // "PENDING", "SUCCESS", "FAILED"
  plan              String
  couponId          String?
  coupon            Coupon?   @relation(fields: [couponId], references: [id])
  demoId            String?
  finalAmount       Int?
  referredByCode    String?   // Referral code that brought this buyer — used to credit referrer on payment success

  // ─── Fulfillment tracking ──────────────────────────────────────────────────
  buyerEmail        String?   // Stored at order-creation so webhook can email even without session
  buyerPhone        String?   // Reserved for future WhatsApp notification
  customDataSnapshot String?  // JSON blob of form values — lets webhook create event without client
  fulfillment       PaymentFulfillment? // Created once event is provisioned

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([referredByCode])
  @@index([status])
}

// ─── Idempotent fulfillment record — one per paid order ─────────────────────
// Created by whichever path fires first (webhook OR client verify).
// Acts as a unique guard so no duplicate events are ever created.
model PaymentFulfillment {
  id          String   @id @default(cuid())
  paymentId   String   @unique        // FK → Payment.id
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventId     String   @unique        // FK → Event.id  (the created event)
  shareUrl    String                  // e.g. /p/surprise-abc123
  emailSentAt DateTime?              // null = email not yet sent / failed
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

// Interaction tracking
model Response {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  action      String    // "VIEWED", "ACCEPTED", "REJECTED"
  device      String?
  browser     String?
  country     String?
  city        String?
  
  createdAt   DateTime  @default(now())

  @@index([eventId, action])
  @@index([createdAt])
}

// Available theme configurations
model Theme {
  id           String    @id @default(cuid())
  name         String    @unique
  isPremium    Boolean   @default(false)
  defaultData  String?
  price        Int       @default(0)
  durationDays Int       @default(7)
  isActive     Boolean   @default(true)
  title        String?   // Admin-overridable display title
  description  String?   // Admin-overridable description
  thumbnailUrl String?   // Admin-overridable thumbnail image
  
  events      Event[]
}

// Available theme configurations
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    @default("FIXED")
  discountValue  Int
  maxUses        Int?
  maxUsesPerUser Int?      @default(1)
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]
}

// NextAuth necessary models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Referral Wallet Transactions ────────────────────────────────────────────
model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String   // "REFERRAL_EARNED" | "SPENT_ON_TEMPLATE" | "WITHDRAWAL_PENDING" | "WITHDRAWAL_PAID"
  amount      Int      // in paise — positive = credit, negative = debit
  description String
  referenceId String?  // paymentId / eventId that triggered this
  status      String   @default("COMPLETED") // "COMPLETED" | "PENDING" | "FAILED"

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─── Platform System Settings ────────────────────────────────────────────────
model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ─── Cold Email Campaign System ──────────────────────────────────────────────
model SmtpAccount {
  id                String          @id @default(cuid())
  name              String
  provider          String          @default("custom") // "gmail", "smtp", "outlook", etc.
  host              String
  port              Int             @default(587)
  username          String
  encryptedPassword String
  fromName          String          @default("OurStory")
  fromEmail         String
  dailyLimit        Int             @default(200)
  hourlyLimit       Int             @default(30)
  delayMs           Int             @default(5000)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  recipients        ColdRecipient[]
  logs              ColdLog[]
  campaigns         ColdCampaign[]
}

model ColdCampaign {
  id              String          @id @default(cuid())
  name            String
  subject         String
  content         String
  status          String          @default("DRAFT") // "DRAFT", "QUEUED", "RUNNING", "PAUSED", "COMPLETED", "CANCELLED"
  smtpAccountId   String?
  smtpAccount     SmtpAccount?    @relation(fields: [smtpAccountId], references: [id], onDelete: SetNull)
  totalRecipients Int             @default(0)
  sentCount       Int             @default(0)
  failedCount     Int             @default(0)
  pendingCount    Int             @default(0)
  hourlyLimit     Int?            @default(30)
  dailyLimit      Int?            @default(200)
  delayMs         Int?            @default(5000)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  recipients      ColdRecipient[]
  logs            ColdLog[]
}

model ColdRecipient {
  id             String        @id @default(cuid())
  campaignId     String
  campaign       ColdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  status         String        @default("PENDING") // "PENDING", "PROCESSING", "SENT", "FAILED", "SKIPPED"
  smtpAccountId  String?
  smtpAccount    SmtpAccount?  @relation(fields: [smtpAccountId], references: [id], onDelete: SetNull)
  attemptCount   Int           @default(0)
  lastError      String?
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  logs           ColdLog[]

  @@index([campaignId, status])
  @@index([status, nextAttemptAt])
}

model ColdLog {
  id             String        @id @default(cuid())
  campaignId     String?
  campaign       ColdCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId    String?
  recipient      ColdRecipient?@relation(fields: [recipientId], references: [id], onDelete: SetNull)
  smtpAccountId  String?
  smtpAccount    SmtpAccount?  @relation(fields: [smtpAccountId], references: [id], onDelete: SetNull)
  recipientEmail String
  status         String        // "SENT", "FAILED", "RETRYING", "PAUSED", "SYSTEM"
  attempt        Int           @default(1)
  error          String?
  createdAt      DateTime      @default(now())

  @@index([campaignId])
  @@index([smtpAccountId])
  @@index([createdAt])
}


