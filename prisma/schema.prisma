// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// User model for NextAuth & our platform
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  plan          String    @default("FREE") // "FREE", "PREMIUM", "LIFETIME"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  events        Event[]
  payments      Payment[]
  accounts      Account[]
  sessions      Session[]
}

// Storing the created memory pages (events)
model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId     String
  theme       Theme     @relation(fields: [themeId], references: [id])
  
  customData  String?   // SQLite workaround for Json type
  
  status      String    @default("DRAFT") // "DRAFT", "PUBLISHED", "DISABLED", "EXPIRED"
  expiresAt   DateTime? 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media       Media[]
  responses   Response[]
}

// Uploaded photos/audio linked to events
model Media {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  url       String
  type      String    // "IMAGE", "AUDIO", "VIDEO"
  size      Int?      
  
  createdAt DateTime  @default(now())
}

// Razorpay transaction records
model Payment {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  
  razorpayOrderId  String    @unique
  razorpayPaymentId String?  @unique
  amount           Int       
  currency         String    @default("INR")
  status           String    @default("PENDING") // "PENDING", "SUCCESS", "FAILED"
  plan             String
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Interaction tracking
model Response {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  action      String    
  device      String?
  browser     String?
  country     String?
  city        String?
  
  createdAt   DateTime  @default(now())
}

// Available theme configurations
model Theme {
  id          String    @id @default(cuid())
  name        String    
  isPremium   Boolean   @default(false)
  defaultData String?   // SQLite workaround for Json type
  
  events      Event[]
}

// NextAuth necessary models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? 
  access_token       String? 
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? 
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
